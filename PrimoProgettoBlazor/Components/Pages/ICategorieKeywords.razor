@page "/CategorieKeywords"
@inject ICategoriaKeywordService categoriaKeywordService
@inject ISessioneService sessioneService
@inject IMessageService messageService
@inject DialogService dialog
@inject NotificationService notify

@if (categoria == null)
{
	<RadzenRow class="mb-2">
		<RadzenFormField Text="Sessioni" class="w-100">
			<RadzenDropDown Data="@sessioni" @bind-Value="@sessione" AllowClear="true" AllowFiltering="true" class="w-100" />
		</RadzenFormField>
	</RadzenRow>
	<ListaCategorieKeyword CategorieKeywords="@CategorieKeywords.Where(x => sessione != null ? sessione.Id == x.SessioneId : true)" OnPremiDelete="Elimina" OnPremiModifica="Modifica" />
	<RadzenFab Style="position:fixed;bottom:1rem;right:1rem;" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Icon="add" Click="x => Modifica(new CategoriaKeyword())" />
}
else
{
	<EditForm Model="categoria" OnSubmit="Salva">
		<RadzenRow>
			<RadzenColumn Size="12" Visible="@(sessione == null)">
				<RadzenFormField Text="Sessione" class="w-100">
					<RadzenDropDown Data="sessioni" @bind-Value="@categoria.Sessione" class="w-100" AllowClear="true" AllowFiltering="true" />
				</RadzenFormField>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="6">
				<RadzenFormField Text="Nome" class="w-100">
					<RadzenTextBox @bind-Value="@categoria.Nome" class="w-100" />
				</RadzenFormField>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="6" class="w-100">
				<RadzenText Text="Visibile solo dall'amministratore"></RadzenText>
				<RadzenSwitch @bind-Value="@categoria.VisibileDaAdmin" />
			</RadzenColumn>
			<RadzenColumn Size="12">
				<RadzenFormField Text="Descrizione" class="w-100">
					<RadzenTextArea @bind-Value="@categoria.Descrizione" class="w-100" />
				</RadzenFormField>
			</RadzenColumn>
		</RadzenRow>
		<RadzenFab Style="position:fixed;bottom:1rem;right:1rem;" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Icon="save" />
	</EditForm>
}

@code {
	[CascadingParameter] public Giocatore giocatore { get; set; }

	public List<CategoriaKeyword> CategorieKeywords { get; set; } = new List<CategoriaKeyword>();
	CategoriaKeyword? categoria = null;

	List<Sessione> sessioni = new List<Sessione>(); 
	Sessione? sessione = null; 
	protected override async Task OnInitializedAsync()
	{
		await Carica();
	}

	private async Task Carica()
	{
		CategorieKeywords = await categoriaKeywordService.GetCategorieKeyword(giocatore);
		sessioni = await sessioneService.GetSessioni(); 
	}

	private void Modifica(CategoriaKeyword quale)
	{
		categoria = quale;
	}

	private async Task Salva()
	{
		if(categoria.Id == 0)
		{
			if (sessione != null)
			{
				categoria.Sessione = sessione;
				categoria.SessioneId = sessione.Id;
			}
			else
			{
				categoria.SessioneId = categoria.Sessione.Id;
			}
		}
		string errore = await categoriaKeywordService.SalvaCategoriaKeyword(categoria);
		messageService.MostraMessaggioEsito(string.IsNullOrEmpty(errore), "Inserimento riuscito", errore); 
		categoria = null;
		await Carica();
	}

	private async Task Elimina(CategoriaKeyword quale)
	{
		bool result = await messageService.ChiediConferma("Eliminazione categoria", "Sei sicuro di voler eliminare questa categoria?"); 
		if (result)
		{
			string errore = await categoriaKeywordService.EliminaCategoriaKeyword(quale);
			messageService.MostraMessaggioEsito(string.IsNullOrEmpty(errore), "Elinimazione riuscita!", errore);
			await Carica();
		}
	}
}
