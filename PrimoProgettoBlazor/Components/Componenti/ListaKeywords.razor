<RadzenRow>
	@foreach (Keyword singola in scelta.Keywords)
	{
		<RadzenColumn SizeMD="3" Size="12">
			<RadzenCard @onclick="x => VisualizzaDescrizione(singola)">
				<RadzenRow>
					<RadzenColumn Size="12">
						<RadzenText TextAlign="TextAlign.Center" Text="@singola.Titolo" />
					</RadzenColumn>
				</RadzenRow>
				<RadzenRow>
					<RadzenColumn Size="6" Visible="@OnPremiDelete.HasDelegate">
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="async x => await PremiDelete(singola)" class="w-100" />
					</RadzenColumn>
					<RadzenColumn Size="6" Visible="@OnPremiModifica.HasDelegate">
						<RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="edit" Click="async x => await PremiModifica(singola)" class="w-100" />
					</RadzenColumn>
				</RadzenRow>
			</RadzenCard>
		</RadzenColumn>
	}
</RadzenRow>
@code {
	[Parameter] public CategoriaKeyword scelta { get; set; }

	[Parameter] public EventCallback<Keyword> OnPremiDelete { get; set; }
	[Parameter] public EventCallback<Keyword> OnPremiModifica { get; set; }
	[Parameter] public EventCallback<Keyword> OnVisualizzaDescrizione { get; set; }

	private async Task PremiDelete(Keyword keyword)
	{
		if (OnPremiDelete.HasDelegate)
		{
			await OnPremiDelete.InvokeAsync(keyword); 
		}
	}

	private async Task PremiModifica(Keyword keyword)
	{
		if (OnPremiModifica.HasDelegate)
		{
			await OnPremiModifica.InvokeAsync(keyword);
		}
	}

	private async Task VisualizzaDescrizione(Keyword keyword)
	{
		if (OnVisualizzaDescrizione.HasDelegate)
		{
			await OnVisualizzaDescrizione.InvokeAsync(keyword); 
		}
	}
}
