@page "/"
@inject NavigationManager navman
@inject IPersonaggioService personaggioService
@inject IGiocatoreService giocatoreService
@inject ISessioneService sessioneService
@inject ICategoriaKeywordService categoriaKeywordService
@inject IMessageService messageService
@inject DialogService dialog
@inject NotificationService notify

@if (personaggio == null)
{
	<RadzenRow class="mb-2">
		<RadzenColumn Size="12">
			<RadzenFormField Text="Sessione" class="w-100">
				<RadzenDropDown Data="sessioni" @bind-Value="sessioneScelta" Change="@(x => scelta = new CategoriaKeyword())" AllowFiltering="true" class="w-100" AllowClear="true" />
			</RadzenFormField>
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenText Text="Personaggi" TextStyle="TextStyle.DisplayH5" />
	</RadzenRow>
	<RadzenRow class="mb-2">
		@foreach (Personaggio personaggio in giocatore.Personaggi.Where(x => (sessioneScelta != null && sessioneScelta.Id != 0) ? x.SessioneId == sessioneScelta.Id : true))
		{
			<RadzenColumn Size="6" SizeMD="3">
				<RadzenCard>
					<RadzenRow>
						<RadzenText TagName="TagName.H2" TextStyle="TextStyle.DisplayH5" class="w-100" TextAlign="TextAlign.Center">@personaggio.Nome</RadzenText>
						@if (sessioneScelta == null || sessioneScelta.Id == 0)
						{
							<RadzenText TagName="TagName.H3" TextStyle="TextStyle.DisplayH6" class="w-100" TextAlign="TextAlign.Center">@personaggio.Sessione.Nome</RadzenText>
						}
					</RadzenRow>
					<RadzenRow>
						<RadzenColumn>
							<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
								<RadzenButton class="w-50" ButtonStyle="ButtonStyle.Secondary" Icon="edit" Click="x => ApriScheda(personaggio)" />
							</RadzenStack>
						</RadzenColumn>
						<RadzenColumn>
							<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
								<RadzenButton class="w-50" ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="x => EliminaPersonaggio(personaggio)" />
							</RadzenStack>
						</RadzenColumn>
					</RadzenRow>
				</RadzenCard>
			</RadzenColumn>
		}
	</RadzenRow>
	<RadzenRow Visible="@(sessioneScelta != null && sessioneScelta.Id != 0)">
		<RadzenText Text="Keywords" TextStyle="TextStyle.DisplayH5" />
	</RadzenRow>
	<RadzenRow Visible="@(sessioneScelta != null && sessioneScelta.Id != 0)">
		<RadzenColumn Size="12">
			<RadzenFormField Text="Categoria keyword" class="w-100">
				<RadzenDropDown Data="CategoriaKeywords.Where(x => sessioneScelta != null && sessioneScelta.Id != 0 ? x.SessioneId == sessioneScelta.Id : true)" Placeholder="Scegli una categoria" @bind-Value="scelta" TextProperty="@(nameof(CategoriaKeyword.Nome))" class="w-100">
					<EmptyTemplate>
						<div class="p-1">
							<h5 style="text-align:center">Nessuna categoria keyword presente per questa sessione</h5>
						</div>
					</EmptyTemplate>
				</RadzenDropDown>
			</RadzenFormField>
		</RadzenColumn>
		<RadzenColumn Size="12" Visible="@(scelta.Id != 0)">
			<ListaKeywords scelta="@scelta" OnVisualizzaDescrizione="MostraSchedaKeyword" />
		</RadzenColumn>
	</RadzenRow>

	<RadzenFab Style="position:fixed;bottom:1rem;right:1rem;" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Click="x => CreaPersonaggio()" Icon="add" />
}
else
{
	<SchedaPersonaggio IsAdmin="@giocatore.IsAdmin" personaggio="personaggio" OnReset="ResettaPersonaggio" OnClose="ResettaPersonaggio" />
}



@code {
	List<Personaggio> Personaggi = new List<Personaggio>();
	[CascadingParameter]
	public Giocatore giocatore { get; set; } = new Giocatore();

	Personaggio? personaggio = null;
	List<Sessione> sessioni = new List<Sessione>();
	Sessione? sessioneScelta = new Sessione();

	List<CategoriaKeyword> CategoriaKeywords = new List<CategoriaKeyword>();
	CategoriaKeyword scelta = new CategoriaKeyword();

	protected override async Task OnInitializedAsync()
	{
		sessioni = await sessioneService.GetSessioni();
		CategoriaKeywords = await categoriaKeywordService.GetCategorieKeyword(giocatore, true);
	}

	private void ScegliCategoria(CategoriaKeyword categoriaKeyword)
	{
		scelta = categoriaKeyword;
	}

	private async Task CreaPersonaggio()
	{
		Personaggio nuovo = new Personaggio()
			{
				GiocatoreId = giocatore.Id,
				Giocatore = giocatore,
				Nome = "Nuovo personaggio"
			};

		if (sessioneScelta == null || sessioneScelta.Id == 0)
		{
			bool inserisci = await InserisciSessione(nuovo);
			if (!inserisci)
			{
				return;
			}
		}
		else
		{
			nuovo.SessioneId = sessioneScelta.Id;
			nuovo.Sessione = sessioneScelta; 
		}
		string errore = await personaggioService.SalvaPersonaggio(nuovo);
		messageService.MostraMessaggioEsito(string.IsNullOrEmpty(errore), "Personaggio inserito!", errore);
	}

	private async Task<bool> InserisciSessione(Personaggio quale)
	{
		var result = await dialog.OpenAsync<SchedaSessione>("Sessione personaggio", null, new DialogOptions()
			{
				Resizable = false,
				Draggable = false
			});

		if (result != null)
		{
			if (result is Sessione sessione)
			{
				quale.SessioneId = sessione.Id;
				quale.Sessione = sessione;
			}
			return true;
		}
		else
		{
			return false;
		}
	}

	private async Task ApriScheda(Personaggio quale)
	{
		if (quale.Id == 0)
		{
			if (sessioneScelta.Id == 0)
			{
				await InserisciSessione(quale);
			}
			else
			{
				quale.SessioneId = sessioneScelta.Id;
				quale.Sessione = sessioneScelta;
			}
			quale.Giocatore = giocatore;
			quale.GiocatoreId = giocatore.Id;
			personaggio = quale;
		}
		else
		{
			personaggio = await personaggioService.GetPersonaggioById(quale.Id);
		}
	}

	private async Task ResettaPersonaggio()
	{
		personaggio = null;
		giocatore = await giocatoreService.GetGiocatoreById(giocatore.Id);
		await InvokeAsync(StateHasChanged);
	}

	private async Task Chiudi()
	{
		personaggio = null;
		await InvokeAsync(StateHasChanged);
	}

	private async Task EliminaPersonaggio(Personaggio personaggio)
	{

		bool result = await messageService.ChiediConferma("Eliminazione personaggio", "Sei sicuro di voler eliminare questo personaggio?");
		if (result)
		{
			string errore = await personaggioService.EliminaPersonaggio(personaggio);
			messageService.MostraMessaggioEsito(string.IsNullOrEmpty(errore), "Personaggio eliminato!", errore);
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task MostraSchedaKeyword(Keyword keyword)
	{
		await dialog.OpenAsync<SchedaKeyword>($"Keyword - {keyword.Titolo}", new Dictionary<string, object>()
		{
			{"Descrizione", keyword.Descrizione}
		},
		new DialogOptions()
			{
				Resizable = false
			}
		);
	}
}
