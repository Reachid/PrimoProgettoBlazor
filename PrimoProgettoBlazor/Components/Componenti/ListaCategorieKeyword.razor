<RadzenRow>
	@foreach (CategoriaKeyword singola in CategorieKeywords)
	{
		<RadzenColumn SizeMD="6" Size="12">
			<RadzenCard>
				<RadzenRow>
					<RadzenColumn Size="12">
						<RadzenText TextAlign="TextAlign.Center" Text="@singola.Nome" />
					</RadzenColumn>
				</RadzenRow>
				<RadzenRow>
					@if (OnPremiDelete.HasDelegate)
					{
						<RadzenColumn Size="6">
							<RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="async x => await PremiDelete(singola)" class="w-100" />
						</RadzenColumn>
					}

					@if (OnPremiModifica.HasDelegate)
					{
						<RadzenColumn Size="6">
							<RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="edit" Click="async x => await PremiModifica(singola)" class="w-100" />
						</RadzenColumn>
					}
				</RadzenRow>
			</RadzenCard>
		</RadzenColumn>
	}
</RadzenRow>


@code {
	[Parameter] public IEnumerable<CategoriaKeyword> CategorieKeywords { get; set; } = new List<CategoriaKeyword>();
	[Parameter] public EventCallback<CategoriaKeyword> OnPremiDelete { get; set; }
	[Parameter] public EventCallback<CategoriaKeyword> OnPremiModifica { get; set; }

	private async Task PremiDelete(CategoriaKeyword categoriaKeyword)
	{
		if (OnPremiDelete.HasDelegate)
		{
			await OnPremiDelete.InvokeAsync(categoriaKeyword); 
		}
	}

	private async Task PremiModifica(CategoriaKeyword categoriaKeyword)
	{
		if (OnPremiModifica.HasDelegate)
		{
			await OnPremiModifica.InvokeAsync(categoriaKeyword);
		}
	}
}
